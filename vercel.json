{
  "framework": "astro",
  "installCommand": "pnpm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/feed",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/article/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/tag/:slug*",
      "destination": "/tags/:slug*",
      "permanent": true
    }
  ]

}
